# Copy to .env (`cp .env.example .env`). Local-only defaults; no real secrets belong in this file.

# --- FHIR store (HAPI + Postgres) ---
HAPI_IMAGE_TAG=v8.12.0-2
HAPI_PORT=8080
HAPI_DB_NAME=hapi
HAPI_DB_USER=hapi
HAPI_DB_PASSWORD=hapi_local_only
HAPI_JAVA_OPTS=-Xms512m -Xmx2g
FHIR_BASE_URL=http://localhost:8080/fhir
# sample = demo personas + 2,000 random people; full = everyone
FHIR_LOAD=sample

# --- Data generation ---
SEED=42
N=20000

# --- API ---
API_PORT=8000
# Used to sign guest session cookies. Generate one for deployment: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=change-me-local-only
SESSION_TTL_MINUTES=120

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Optional LLM (off by default; deterministic templates are used when false) ---
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Optional AI planner analyst (docs/DECISIONS.md D-045) ---
# Off unless a key is set. Aggregate, suppressed data only; proposals need a planner's approval.
ANTHROPIC_API_KEY=
AGENT_ENABLED=true
AGENT_MODEL=claude-haiku-5-5
AGENT_MAX_STEPS=8
AGENT_QUESTIONS_PER_HOUR=15
